"""Standalone sanity check for api/observability.py.

Run this WITHOUT Docker and WITHOUT torch/spacy/transformers installed.
It builds a tiny throwaway FastAPI app using ONLY your three middlewares
from api/observability.py, so it validates your actual TODO code in
isolation from the heavy M10 RAG/KG dependencies.

Usage (from repo root, with api/ as a package -- needs api/__init__.py):
    python check_observability.py
"""
import json
import sys

from fastapi import FastAPI
from fastapi.testclient import TestClient

try:
    from api.observability import (
        MetricsMiddleware,
        RequestIdMiddleware,
        StructuredLoggingMiddleware,
        requests_total,
    )
except ImportError as exc:
    print(f"FAIL: could not import from api.observability -- {exc}")
    sys.exit(1)

failures = []


def check(label, condition):
    status = "PASS" if condition else "FAIL"
    print(f"{status}: {label}")
    if not condition:
        failures.append(label)


# Build a minimal app with ONLY your middlewares -- no rag.py/kg.py/nlp.py.
app = FastAPI()
app.add_middleware(MetricsMiddleware)
app.add_middleware(StructuredLoggingMiddleware)
app.add_middleware(RequestIdMiddleware)


@app.get("/ping")
def ping():
    return {"ok": True}


@app.get("/boom")
def boom():
    raise ValueError("intentional")


client = TestClient(app, raise_server_exceptions=False)

# --- Check 1: X-Request-ID header present, >= 8 chars ---
resp = client.get("/ping")
req_id = resp.headers.get("x-request-id")
check("response status is 200", resp.status_code == 200)
check("X-Request-ID header present", req_id is not None)
check("X-Request-ID length >= 8", bool(req_id) and len(req_id) >= 8)

# --- Check 2: requests_total counter increments for (path, status) ---
before = requests_total.labels(path="/ping", status="200")._value.get()
client.get("/ping")
after = requests_total.labels(path="/ping", status="200")._value.get()
check("requests_total incremented by 1", after == before + 1)

# --- Check 3: two sequential requests get DIFFERENT request ids ---
r1 = client.get("/ping").headers.get("x-request-id")
r2 = client.get("/ping").headers.get("x-request-id")
check("two requests get distinct request ids", r1 != r2)

# --- Check 4: /metrics-style label call doesn't crash on non-2xx ---
resp2 = client.get("/does-not-exist")
check("404 request does not crash the app", resp2.status_code == 404)
check("404 response still carries X-Request-ID", "x-request-id" in resp2.headers)

print()
if failures:
    print(f"{len(failures)} check(s) FAILED: {failures}")
    sys.exit(1)
else:
    print("All checks PASSED.")
    sys.exit(0)